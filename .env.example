
APP_NAME=AI Web Research Agent
APP_VERSION=0.1.0
APP_ENV=development

HOST=127.0.0.1
PORT=8000

LOG_LEVEL=INFO

USER_AGENT=AIWebResearchAgent/0.1
REQUEST_TIMEOUT=10.0
CRAWL_DELAY=0.5
MAX_RETRIES=3

USE_BROWSER=false
BROWSER_TIMEOUT=30.0
BROWSER_RENDER_DELAY=1.0
MIN_VISIBLE_TEXT=200

LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_CONTEXT=12000

# SQLAlchemy async connection string.
# Production: postgresql+asyncpg://user:pass@host:5432/research
DATABASE_URL=sqlite+aiosqlite:///./research.db
